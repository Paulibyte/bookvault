<%- include('_top') %>
<div class="section-title"><h1 style="margin:0">Shipments</h1><a class="small" href="/admin/settings#shipping">Delivery prices &amp; store location</a></div>
<div class="tabs-inline">
  <% [['processing','To ship'],['shipped','In transit'],['delivered','Delivered'],['cancelled','Cancelled'],['all','All']].forEach(function(t){ %>
  <a class="chip <%= status === t[0] ? 'on' : '' %>" href="/admin/shipments?status=<%= t[0] %><%= who ? '&who=' + who : '' %>"><%= t[1] %></a><% }) %>
  <span style="width:1rem"></span>
  <% [['','Everyone'],['store','Store ships'],['authors','Authors ship']].forEach(function(t){ %>
  <a class="chip <%= who === t[0] ? 'on' : '' %>" href="/admin/shipments?status=<%= status %><%= t[0] ? '&who=' + t[0] : '' %>"><%= t[1] %></a><% }) %>
</div>
<% if (!rows.length) { %><div class="card empty">Nothing here.</div><% } %>
<div class="lib">
<% rows.forEach(function(r){ %>
  <div class="card stack">
    <div class="spread">
      <div><a href="/admin/orders/<%= r.order_id %>" class="mono"><strong><%= r.reference %></strong></a> <span class="small muted">· <%= r.pen_name ? 'Shipped by author ' + r.pen_name : 'Shipped by the store' %> · from <%= r.origin_city ? r.origin_city + ', ' : '' %><%= stateLabel(r.origin_state || '') %></span></div>
      <span class="status <%= r.status === 'delivered' ? 'paid' : r.status === 'cancelled' ? 'cancelled' : 'awaiting_confirmation' %>"><%= r.status === 'processing' ? 'to ship' : r.status %></span>
    </div>
    <div class="grid2" style="gap:1rem">
      <div><div class="small muted">Books</div><div><%= r.items.join(', ') %></div>
        <div class="small muted" style="margin-top:.4rem"><%= { doorstep: 'Doorstep delivery', park: 'Bus-park pickup (waybill)', pickup: 'Collect from seller' }[r.method] %> · <%= naira(r.fee_kobo) %> · <%= (r.weight_kg || 0).toFixed(1) %> kg</div></div>
      <div><div class="small muted">Send to</div><div><strong><%= r.ship_name %></strong> · <a href="tel:<%= r.ship_phone %>"><%= r.ship_phone %></a></div>
        <div class="small"><%= [r.ship_address, r.ship_landmark, r.ship_city, stateLabel(r.ship_state)].filter(Boolean).join(', ') %></div></div>
    </div>
    <% if (r.status === 'processing' || r.status === 'shipped') { %>
    <form method="post" action="/admin/shipments/<%= r.id %>" class="row" style="align-items:flex-end">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="/admin/shipments?status=<%= status %><%= who ? '&who=' + who : '' %>">
      <div class="field" style="margin:0;flex:1;min-width:150px"><label class="small">Courier / transport</label><input type="text" name="courier" value="<%= r.courier || '' %>" placeholder="GIG, GUO, Peace Mass…"></div>
      <div class="field" style="margin:0;flex:1;min-width:150px"><label class="small">Tracking / waybill no.</label><input type="text" name="tracking" value="<%= r.tracking || '' %>"></div>
      <% if (r.status === 'processing') { %><button class="btn green" name="status" value="shipped">Mark shipped</button><% } %>
      <% if (r.status === 'shipped') { %><button class="btn ghost" name="status" value="shipped">Update</button><button class="btn green" name="status" value="delivered">Mark delivered</button><% } %>
      <% if (r.status === 'processing') { %><button class="btn ghost" name="status" value="cancelled" formnovalidate>Cancel</button><% } %>
    </form>
    <% } else if (r.courier || r.tracking) { %><div class="small"><%= r.courier %> · <span class="mono"><%= r.tracking %></span></div><% } %>
  </div>
<% }) %>
</div>
<%- include('_bottom') %>

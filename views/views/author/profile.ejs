<%- include('_top') %>
<form class="card" method="post" action="/author/profile?_csrf=<%= csrf %>" enctype="multipart/form-data" style="max-width:720px">
  <div class="grid2">
    <div class="field"><label>Pen name</label><input type="text" name="pen_name" value="<%= author.pen_name %>" required></div>
    <div class="field"><label>Phone</label><input type="tel" name="phone" value="<%= author.phone || '' %>"></div>
  </div>
  <div class="field"><label>Institution / organisation</label><input type="text" name="institution" value="<%= author.institution || '' %>"></div>
  <div class="field"><label>Bio</label><textarea name="bio"><%= author.bio || '' %></textarea></div>
  <h3 style="margin-top:1.2rem">Shipping printed books</h3>
  <div class="grid2">
    <div class="field"><label>I ship from (state)</label><select name="ship_state"><option value="">— Choose —</option><% states.forEach(function(s){ %><option value="<%= s %>" <%= author.ship_state === s ? 'selected' : '' %>><%= stateLabel(s) %></option><% }) %></select></div>
    <div class="field"><label>Town / city</label><input type="text" name="ship_city" value="<%= author.ship_city || '' %>"></div>
  </div>
  <div class="field"><label>Pickup address <span class="hint">(shown only to buyers in your state who choose "Collect from seller")</span></label><input type="text" name="pickup_address" value="<%= author.pickup_address || '' %>" placeholder="e.g. Room 12, Civil Eng. Dept, Fed. Poly Nekede"></div>
  <div class="field"><label>Profile photo</label><input type="file" name="photo" accept="image/*"></div>
  <p class="small muted">Legal name on file: <strong><%= author.legal_name %></strong> — contact the store to change it.</p>
  <button class="btn">Save profile</button>
</form>
<%- include('_bottom') %>

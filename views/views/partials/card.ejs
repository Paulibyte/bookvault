<article class="book">
  <a class="cover-link" href="/book/<%= p.slug %>" style="position:relative;display:block">
    <%- include('cover', { p: p, showBadge: true }) %>
    <% if (ranks && ranks.get(p.id)) { %><span class="rank">#<%= ranks.get(p.id) %> Bestseller</span><% } %>
  </a>
  <div class="body">
    <a class="cover-link title" href="/book/<%= p.slug %>"><%= p.title %></a>
    <div class="author"><%= p.author_name || p.author || '' %><%= p.kind === 'software' && p.platform ? (p.author_name || p.author ? ' · ' : '') + p.platform : '' %></div>
    <% if (p.rating_count) { %><%- include('stars', { r: p.rating_avg, n: p.rating_count }) %><% } else if (p.sales_count) { %><span class="small muted"><%= p.sales_count %> sold</span><% } %>
    <div class="foot">
      <span class="price"><%= p.price_kobo ? naira(p.price_kobo) : 'Free' %></span>
      <% if (p.format === 'print' && !(p.stock > 0)) { %>
        <span class="small stock-out">Out of stock</span>
      <% } else if (owned.has(p.id)) { %>
        <a class="btn sm green" href="/library">Owned</a>
      <% } else if (cart.has(p.id)) { %>
        <a class="btn sm ghost" href="/cart">In cart</a>
      <% } else { %>
        <form method="post" action="/cart/add/<%= p.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">Add</button></form>
      <% } %>
    </div>
  </div>
</article>

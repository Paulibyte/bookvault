<%- include('_top') %>
<% const isNew = !p.id; const sw = p.kind === 'software'; %>
<% if (p.status === 'rejected' && p.review_note) { %><div class="flash error"><strong>Reviewer note:</strong> <%= p.review_note %></div><% } %>
<form method="post" action="/author/books/<%= p.id || 'new' %>?_csrf=<%= csrf %>" enctype="multipart/form-data" data-once style="max-width:860px">
  <% if (isNew) { %>
  <fieldset>
    <legend>What are you publishing?</legend>
    <div class="radio-cards">
      <label><input type="radio" name="kind" value="book" <%= !sw ? 'checked' : '' %>><span>📚 Book or course material<small>PDF or Word — watermarked with each buyer's name and password-protected</small></span></label>
      <label><input type="radio" name="kind" value="software" <%= sw ? 'checked' : '' %>><span>💻 Software or app<small>ZIP file — delivered as uploaded, no watermark</small></span></label>
    </div>
  </fieldset>
  <% } else { %><input type="hidden" name="kind" value="<%= p.kind %>"><% } %>

  <fieldset>
    <legend>Details</legend>
    <div class="field"><label>Title</label><input type="text" name="title" value="<%= p.title || '' %>" required></div>
    <div class="grid2">
      <div class="field"><label>Price (₦)</label><input type="text" inputmode="decimal" name="price" value="<%= p.price_kobo != null ? p.price_kobo / 100 : '' %>" required placeholder="e.g. 2500"></div>
      <div class="field"><label>Category</label><select name="category_id"><option value="">— Choose —</option><% categories.forEach(function(c){ %><option value="<%= c.id %>" <%= Number(p.category_id) === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
    </div>
    <div class="field"><label>…or suggest a new category</label><input type="text" name="new_category" placeholder="e.g. CEC 411 — Traffic Engineering"></div>
    <div class="grid2" data-software hidden>
      <div class="field"><label>Platform</label><select name="platform"><% platforms.forEach(function(pl){ %><option <%= p.platform === pl ? 'selected' : '' %>><%= pl %></option><% }) %></select></div>
      <div class="field"><label>Version</label><input type="text" name="version" value="<%= p.version || '' %>" placeholder="e.g. 2.1"></div>
    </div>
    <div class="field"><label>Description</label><textarea name="description" required placeholder="What's inside, who it's for, course/level, edition, system requirements for software…"><%= p.description || '' %></textarea></div>
  </fieldset>

  <fieldset>
    <legend>Files</legend>
    <div class="grid2">
      <div class="field">
        <label>Cover image</label>
        <% if (p.cover_file) { %><img src="/cover/<%= p.cover_file %>" alt="" style="width:80px;border-radius:6px;margin-bottom:.5rem"><% } %>
        <input type="file" name="cover" accept="image/*">
      </div>
      <div class="field">
        <label><span data-book>Book file (PDF or Word .docx)</span><span data-software hidden>Software file (.zip)</span> <span class="hint">max <%= maxMb %> MB</span></label>
        <% if (p.original_name) { %><div class="small muted" style="margin-bottom:.4rem">Current: <strong><%= p.original_name %></strong> — upload only to replace (needs re-approval)</div><% } %>
        <input type="file" name="file" <%= isNew ? 'required' : '' %>>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Copyright declaration</legend>
    <p class="small muted">Required for every new title, and again when you replace the file or change the title. Your answers are recorded with the date, time and your IP address.</p>
    <div class="field"><label>How do you hold the rights to this work?</label>
      <div class="pay-opts">
        <label class="pay-opt"><input type="radio" name="rights_basis" value="sole" <%= cr.rights_basis === 'sole' ? 'checked' : '' %> required><span><strong>I am the sole author and copyright owner</strong></span></label>
        <label class="pay-opt"><input type="radio" name="rights_basis" value="coauthor" <%= cr.rights_basis === 'coauthor' ? 'checked' : '' %>><span><strong>I am a co-author</strong><span class="small muted">and all co-authors have agreed in writing to this sale</span></span></label>
        <label class="pay-opt"><input type="radio" name="rights_basis" value="licensed" <%= cr.rights_basis === 'licensed' ? 'checked' : '' %>><span><strong>I hold publishing/distribution rights</strong><span class="small muted">licensed to me by the copyright owner</span></span></label>
      </div>
    </div>
    <div class="grid2">
      <div class="field"><label>Co-authors <span class="hint">(if any)</span></label><input type="text" name="co_authors" value="<%= cr.co_authors || '' %>"></div>
      <div class="field"><label>Copyright owner <span class="hint">(if licensed)</span></label><input type="text" name="rights_holder" value="<%= cr.rights_holder || '' %>"></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Publisher <span class="hint">(optional)</span></label><input type="text" name="publisher" value="<%= cr.publisher || '' %>"></div>
      <div class="field"><label>ISBN <span class="hint">(optional)</span></label><input type="text" name="isbn" value="<%= cr.isbn || '' %>"></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Year first published</label><input type="text" name="year_published" value="<%= cr.year_published || '' %>" placeholder="e.g. 2025"></div>
      <div class="field"><label>Edition</label><input type="text" name="edition" value="<%= cr.edition || '' %>" placeholder="e.g. 2nd"></div>
    </div>
    <div class="field"><label>Published or sold anywhere else before?</label>
      <select name="previously_published"><option value="no" <%= cr.previously_published !== 'yes' ? 'selected' : '' %>>No</option><option value="yes" <%= cr.previously_published === 'yes' ? 'selected' : '' %>>Yes</option></select></div>
    <div class="field"><label>Supporting document <span class="hint">(optional — copyright certificate, publisher letter or co-author consent; PDF/image)</span></label><input type="file" name="copyright_doc" accept="image/*,.pdf"></div>
    <div class="declare">
      <label class="check"><input type="checkbox" name="decl_original" value="1"><span>This work is original, or I have the legal right to sell it as described above.</span></label>
      <label class="check"><input type="checkbox" name="decl_third_party" value="1"><span>Any third-party material (images, quotes, tables, code) is used with permission or is properly cited/licensed.</span></label>
      <label class="check"><input type="checkbox" name="decl_license" value="1"><span>I grant <%= settings.store_name %> a non-exclusive right to sell and deliver personalised digital copies of this work, and I keep my copyright.</span></label>
      <label class="check"><input type="checkbox" name="decl_indemnity" value="1"><span>I accept responsibility for any copyright claim arising from this work, and agree the store may remove it and withhold royalties if a valid claim is made.</span></label>
      <div class="field" style="margin:.6rem 0 0"><label>Signature — type your full legal name: <em><%= author.legal_name %></em></label><input type="text" name="signature" autocomplete="off" value=""></div>
    </div>
  </fieldset>
  <div class="row">
    <button class="btn accent" data-busy-text="Uploading… please wait"><%= isNew ? 'Submit for review' : 'Save changes' %></button>
    <a class="btn ghost" href="/author/books">Cancel</a>
  </div>
  <% if (!isNew) { %><p class="small muted" style="margin-top:.8rem">If you're only changing the price or description of a published title, you don't need to fill in the copyright section.</p><% } %>
</form>
<%- include('_bottom') %>

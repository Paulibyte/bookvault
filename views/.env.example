# ---- App ----
PORT=3050
NODE_ENV=production
# Public URL of the store (used for OPay return/callback links)
APP_URL=https://books.yourdomain.com
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Set to 1 once the site is served over https
COOKIE_SECURE=1
# Max size of a product upload, in MB (also raise client_max_body_size in nginx)
MAX_UPLOAD_MB=500

# ---- OPay Checkout (from your OPay merchant dashboard → API keys) ----
# OPAY_MODE=sandbox uses testapi.opaycheckout.com; set to live when ready
OPAY_MODE=sandbox
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=

# Optional: path to qpdf if not on PATH
# QPDF_PATH=/usr/bin/qpdf

<%- include('partials/head') %>
<% const sw = p.kind === 'software'; const print = p.format === 'print'; const prot = !sw && !print && p.protect && (p.file_type === 'pdf' || p.file_type === 'docx'); const readable = !sw && !print && (p.file_type === 'pdf' || (p.file_type === 'docx' && p.reader_pdf)); const inStock = !print || p.stock > 0; %>
<main class="page wrap">
  <%- include('partials/flash') %>
  <p class="small"><a href="<%= sw ? '/?kind=software' : '/' %>">← Back to <%= sw ? 'apps' : 'books' %></a></p>
  <div class="product">
    <%- include('partials/cover', { p: p, showBadge: false }) %>
    <div>
      <% if (p.category) { %><div class="muted small" style="text-transform:uppercase;letter-spacing:.06em;font-weight:700"><%= p.category %></div><% } %>
      <h1><%= p.title %></h1>
      <% if (p.author_name) { %><p class="author-line" style="font-size:1.05rem">by <a href="/authors/<%= p.author_ref %>"><%= p.author_name %></a></p>
      <% } else if (p.author) { %><p class="muted" style="font-size:1.05rem">by <%= p.author %></p><% } %>
      <div class="row" style="margin:.2rem 0 .6rem">
        <% if (p.rating_count) { %><a href="#reviews" style="text-decoration:none"><%- include('partials/stars', { r: p.rating_avg, n: p.rating_count }) %></a><% } %>
        <% if (p.sales_count) { %><span class="small muted"><%= p.sales_count %> sold</span><% } %>
      </div>
      <div class="meta">
        <% if (sw) { %>
          <span class="badge software">Software</span>
          <% if (p.platform) { %><span class="badge"><%= p.platform %></span><% } %>
          <% if (p.version) { %><span class="badge">v<%= p.version %></span><% } %>
        <% } else if (print) { %>
          <span class="badge print">📦 Printed book</span>
          <% if (p.book_condition) { %><span class="badge"><%= p.book_condition %></span><% } %>
          <% if (p.pages) { %><span class="badge"><%= p.pages %> pages</span><% } %>
          <% if (p.weight_kg) { %><span class="badge"><%= p.weight_kg %> kg</span><% } %>
        <% } else { %>
          <span class="badge <%= p.file_type %>"><%= p.file_type === 'docx' ? 'Word document' : p.file_type === 'other' ? 'File' : p.file_type.toUpperCase() %></span>
          <% if (p.pages) { %><span class="badge"><%= p.pages %> pages</span><% } %>
          <% if (readable) { %><span class="badge ok">Read in app · Listen</span><% } %>
        <% } %>
        <% if (!print) { %><span class="badge"><%= humanSize(p.file_size) %></span><% } %>
      </div>
      <div class="buybox">
        <span class="price"><%= p.price_kobo ? naira(p.price_kobo) : 'Free' %></span>
        <% if (!inStock) { %>
          <span class="stock-out">Out of stock</span><span class="small muted">Check back soon.</span>
        <% } else if (owned) { %>
          <a class="btn green" href="/library">You own this — go to library</a>
        <% } else if (inCart) { %>
          <a class="btn accent" href="/cart">In your cart — checkout</a>
        <% } else { %>
          <form method="post" action="/cart/add/<%= p.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="buy_now" value="1"><button class="btn accent">Buy now</button></form>
          <form method="post" action="/cart/add/<%= p.id %>" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost">Add to cart</button></form>
        <% } %>
      </div>
      <% if (print) { %>
      <div class="protect-note"><span style="font-size:1.3rem">🚚</span><div>
        <strong>Delivered anywhere in Nigeria</strong> from <%= delivery.city ? delivery.city + ', ' : '' %><%= delivery.stateLabel(delivery.from) %>.
        <% if (inStock && p.stock <= 5) { %><span class="stock-low">Only <%= p.stock %> left.</span><% } else if (inStock) { %><span class="muted">In stock.</span><% } %>
        <table style="margin-top:.6rem;font-size:.85rem;background:transparent"><thead><tr><th>Delivering to</th><% if (delivery.labels.doorstep) { %><th class="num">Doorstep</th><% } %><% if (delivery.labels.park) { %><th class="num">Bus park</th><% } %><th>Time</th></tr></thead><tbody>
        <% delivery.rows.forEach(function(r){ %><tr><td><%= r.zone %></td><% if (delivery.labels.doorstep) { %><td class="num"><%= r.doorstep != null ? naira(r.doorstep) : '—' %></td><% } %><% if (delivery.labels.park) { %><td class="num"><%= r.park != null ? naira(r.park) : '—' %></td><% } %><td class="small muted"><%= r.eta %></td></tr><% }) %>
        </tbody></table>
        <span class="small muted">Exact price shown at checkout once you pick your state.</span>
      </div></div>
      <% } else if (prot) { %>
      <div class="protect-note"><span style="font-size:1.3rem">🔒</span><div>Your copy is personalised: <strong>your name is printed on every page</strong> and it opens with a <strong>password unique to you</strong>.<% if (readable) { %> Read it right here in the app — online or offline — or let the app <strong>read it aloud</strong> to you.<% } %> You can also download it as a .zip.</div></div>
      <% } else if (sw) { %>
      <div class="protect-note"><span style="font-size:1.3rem">💻</span><div>Delivered as a .zip download in your library as soon as payment is confirmed. Download again any time.</div></div>
      <% } else { %>
      <div class="protect-note"><span style="font-size:1.3rem">📦</span><div>Delivered as a .zip download in your library as soon as payment is confirmed.</div></div>
      <% } %>
      <% if (p.description) { %><h2 style="margin-top:1.8rem">About this <%= sw ? 'software' : 'book' %></h2><div class="desc"><%= p.description %></div><% } %>
    </div>
  </div>

  <% if (settings.reviews_enabled === '1') { %>
  <section id="reviews" style="margin-top:3rem">
    <h2>Ratings &amp; reviews</h2>
    <div class="two" style="align-items:start">
      <div class="card">
        <% if (!reviews.length) { %><p class="muted" style="margin:0">No reviews yet<%= canReview ? ' — be the first!' : '.' %></p><% } %>
        <% reviews.forEach(function(r){ %>
          <div class="review">
            <div class="spread"><strong><%= r.full_name.split(' ')[0] %> <%= (r.full_name.split(' ')[1] || '').charAt(0) %>.</strong><%- include('partials/stars', { r: r.rating }) %></div>
            <% if (r.body) { %><p style="margin:.4rem 0 0" class="desc"><%= r.body %></p><% } %>
            <div class="muted small" style="margin-top:.3rem">Verified buyer · <%= r.updated_at.slice(0,10) %></div>
          </div>
        <% }) %>
      </div>
      <div class="stack">
        <% if (p.rating_count) { %>
        <div class="card">
          <div class="row"><span class="balance"><%= p.rating_avg.toFixed(1) %></span><div><%- include('partials/stars', { r: p.rating_avg }) %><div class="small muted"><%= p.rating_count %> rating<%= p.rating_count === 1 ? '' : 's' %></div></div></div>
          <% dist.forEach(function(d){ %><div class="row small" style="gap:.5rem;margin-top:.3rem"><span style="width:2.2em"><%= d.n %> ★</span><div style="flex:1;height:8px;background:var(--line);border-radius:4px;overflow:hidden"><div style="height:100%;width:<%= reviews.length ? Math.round(d.c / reviews.length * 100) : 0 %>%;background:#f5a623"></div></div><span class="muted" style="width:2em;text-align:right"><%= d.c %></span></div><% }) %>
        </div>
        <% } %>
        <% if (canReview) { %>
        <form class="card" method="post" action="/book/<%= p.slug %>/review">
          <h3><%= myReview ? 'Update your review' : 'Rate this ' + (sw ? 'software' : 'book') %></h3>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="stars-input" style="margin-bottom:.6rem">
            <% for (let i = 5; i >= 1; i--) { %><input type="radio" name="rating" id="st<%= i %>" value="<%= i %>" <%= myReview && myReview.rating === i ? 'checked' : '' %>><label for="st<%= i %>" data-v="<%= i %>" class="<%= myReview && myReview.rating >= i ? 'on' : '' %>" title="<%= i %> star<%= i > 1 ? 's' : '' %>">★</label><% } %>
          </div>
          <div class="field"><textarea name="body" placeholder="What did you think? (optional)" style="min-height:90px"><%= myReview ? myReview.body : '' %></textarea></div>
          <button class="btn">Submit review</button>
        </form>
        <% } else { %>
        <div class="card small muted">Only buyers can rate and review. Buy this <%= sw ? 'software' : 'book' %> to leave a review.</div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <% if (related.length) { %>
  <h2 style="margin-top:3rem">You may also like</h2>
  <div class="grid">
    <% related.forEach(function(r){ %><%- include('partials/card', { p: r, owned: new Set(), cart: new Set(), ranks: null }) %><% }) %>
  </div>
  <% } %>
</main>
<%- include('partials/foot') %>

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %><%= settings.store_name %></title>
<meta name="description" content="<%= settings.store_tagline %>">
<meta name="theme-color" content="#16213a">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/icon-192.png">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css?v=1">
<script src="/js/app.js?v=1" defer></script>
</head>
<body>
<header class="topbar">
  <div class="wrap">
    <a class="brand" href="/"><span class="brand-mark"><%= settings.store_name.charAt(0) %></span><%= settings.store_name %></a>
    <button class="menu-btn" data-menu aria-label="Menu">☰</button>
    <nav class="nav" id="nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Store</a>
      <% if (user) { %>
        <a href="/library" class="<%= path === '/library' ? 'active' : '' %>">My Library</a>
        <a href="/orders" class="<%= path === '/orders' ? 'active' : '' %>">Orders</a>
        <% if (user.is_admin) { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a><% } %>
        <a href="/account">Account</a>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike">Log out</button></form>
      <% } else { %>
        <a href="/how-it-works">How it works</a>
        <a href="/login">Log in</a>
      <% } %>
      <a href="/cart" class="cart-pill">Cart<span class="count"><%= cartCount %></span></a>
    </nav>
  </div>
</header>

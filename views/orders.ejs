<%- include('partials/head') %>
<main class="page wrap">
  <h1>My orders</h1>
  <%- include('partials/flash') %>
  <div class="card">
  <% if (!orders.length) { %><div class="empty">No orders yet. <a href="/">Browse the store</a></div><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Order</th><th>Items</th><th>Method</th><th class="num">Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% orders.forEach(function(o){ %>
      <tr><td class="mono"><%= o.reference %><div class="muted small"><%= o.created_at.slice(0,10) %></div></td>
      <td class="small"><%= o.titles %></td><td><%= o.method === 'opay' ? 'OPay' : 'Bank' %></td>
      <td class="num"><%= naira(o.total_kobo) %></td><td><span class="status <%= o.status %>"><%= o.status.replace('_',' ') %></span></td>
      <td><a class="btn sm ghost" href="<%= o.status === 'paid' ? '/library' : '/order/' + o.reference %>"><%= o.status === 'paid' ? 'Library' : o.status === 'cancelled' ? 'View' : 'Continue' %></a></td></tr>
    <% }) %>
    </tbody></table></div>
  <% } %>
  </div>
</main>
<%- include('partials/foot') %>
